@model MvcMovie.Models.Movie
<div asp-validation-summary="ModelOnly" class="error"></div>
<label asp-for="Title"></label><input asp-for="Title"/><span asp-validation-for="Title"></span>
<label asp-for="ReleaseDate"></label><input asp-for="ReleaseDate" type="date"/><span asp-validation-for="ReleaseDate"></span>
<label asp-for="Genre"></label><input asp-for="Genre"/><span asp-validation-for="Genre"></span>
<label asp-for="Price"></label><input asp-for="Price" type="number" step="0.01"/><span asp-validation-for="Price"></span>
<label asp-for="Rating"></label><input asp-for="Rating"/><span asp-validation-for="Rating"></span>
