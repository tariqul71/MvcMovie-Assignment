@model MvcMovie.Models.Movie
@{ ViewData["Title"] = "Details"; }
<h1>Movie Details</h1><dl><dt>Title</dt><dd>@Model.Title</dd><dt>Release Date</dt><dd>@Model.ReleaseDate.ToString("yyyy-MM-dd")</dd><dt>Genre</dt><dd>@Model.Genre</dd><dt>Price</dt><dd>@Model.Price</dd><dt>Rating</dt><dd>@Model.Rating</dd></dl><a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> | <a asp-action="Index">Back</a>